
# Stabilize installs in CI (e.g. Vercel) by avoiding flaky mirrors and retrying tarball fetches.
registry=https://registry.npmjs.org/

# Retry settings for transient network/cache issues
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000

# Avoid noisy/prolonged install steps in CI
audit=false
fund=false

